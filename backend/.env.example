# Copy to backend/.env. docker-compose.yml loads it into the api container and
# overrides DB_HOST/DB_PORT so the api reaches the postgres service.

# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME="Vision Project Atlas API"
APP_VERSION="2.0.0"
# Unversioned: the console calls /api/...
APP_API_PREFIX="/api"
ENVIRONMENT=development

# =============================================================================
# CORS
# =============================================================================
# The console reaches the API through a same-origin proxy (Vite in dev, nginx
# in the container), so CORS is not normally involved. These cover the case of
# a browser pointed straight at the API host. JSON list.
CORS_ORIGINS='["http://localhost:5173","http://localhost:8080"]'

# =============================================================================
# AUTH
# =============================================================================
# Required -- the app refuses to start without it. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET="generate-your-own-see-comment-above"
JWT_EXPIRE_MINUTES=10080

# Creates this admin account on startup if it does not exist yet. An existing
# account is never changed, so change the password in the app afterwards.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Admin

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
# Empty for console only.
LOG_FILE_PATH=logs/atlas.log

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL only. In Docker the api uses DB_HOST=postgres (set by compose);
# from the host use localhost and the published port.
POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas
DB_HOST=localhost
DB_PORT=5432
DB_MIN_POOL_SIZE=2
DB_MAX_POOL_SIZE=10

# =============================================================================
# VISION LAB
# =============================================================================
LAB_WORKERS=2              # runs processed in parallel
MAX_VIDEO_SECONDS=60       # longer videos are cut
MAX_UPLOAD_MB=200          # per file
MAX_RUNS_IN_FLIGHT=3       # per user, queued + running

# =============================================================================
# MODEL SERVER
# =============================================================================
# Every model runs in models-serve (DEVICE, YOLO_SIZE and model downloads are
# configured there). In Docker, compose points the api at its own `models`
# container; for a GPU server put MODELS_URL=http://<gpu-host>:8500 in the
# repository-root .env instead (compose reads it) and run
# `docker compose up -d --scale models=0`. Outside Docker set it here:
# MODELS_URL=http://localhost:8500
MODELS_TOKEN=              # same value as MODELS_TOKEN on models-serve
MODELS_TIMEOUT=600         # seconds; a model's first use may download it
# WEIGHTS_DIR=./weights
# MEDIA_DIR=./media
