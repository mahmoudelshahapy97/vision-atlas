# Where the Vite dev server proxies /api, /media and /health.
# The API's default port is 8000 (uvicorn locally, or the api container).
VITE_API_TARGET=http://127.0.0.1:8000

# Dev-server and preview ports.
VITE_PORT=5173
VITE_PREVIEW_PORT=4173

# Only for serving the built console from a different origin than the API
# (then the API's CORS_ORIGINS must include the console's origin). Leave unset
# for the normal same-origin setup.
# VITE_API_URL=https://atlas-api.example.com
