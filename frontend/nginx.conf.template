# Production counterpart of the Vite dev proxy in vite.config.js.
#
# Same contract: the browser only ever talks to this origin; nginx forwards
# /api, /media, /health and FastAPI's /docs to the API. Keep the two files in
# step -- a path proxied in dev but not here is a 404 that only shows up after
# a build.
#
# Rendered by envsubst at container start (see the Dockerfile), so
# ${ATLAS_API_URL} comes from the environment rather than being baked in.

server {
    listen       80;
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    proxy_http_version 1.1;
    # The first run of a lab downloads and loads its model; that can take a while.
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    # Lab inputs include videos (MAX_UPLOAD_MB=200 by default) and model
    # weights; nginx's 1 MB default would reject them first.
    client_max_body_size 250m;

    # Client-side routes (/projects/12/lab, /runs, /models ...) all load the SPA.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Hashed asset filenames: safe to cache hard. index.html must never be
    # cached, or a deploy leaves browsers pointing at assets that are gone.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-store";
    }

    # API and lab samples. Uploads stream straight through instead of being
    # spooled to disk by nginx first.
    location /api/ {
        proxy_pass              ${ATLAS_API_URL};
        proxy_request_buffering off;
        proxy_set_header        Host              $host;
        proxy_set_header        X-Real-IP         $remote_addr;
        proxy_set_header        X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header        X-Forwarded-Proto $scheme;
    }

    # Run inputs and outputs (images, videos, downloads).
    location /media/ {
        proxy_pass       ${ATLAS_API_URL};
        proxy_set_header Host $host;
    }

    location = /health {
        proxy_pass       ${ATLAS_API_URL};
        proxy_set_header Host $host;
    }

    location /docs {
        proxy_pass       ${ATLAS_API_URL};
        proxy_set_header Host $host;
    }

    location /redoc {
        proxy_pass       ${ATLAS_API_URL};
        proxy_set_header Host $host;
    }

    location = /openapi.json {
        proxy_pass       ${ATLAS_API_URL};
        proxy_set_header Host $host;
    }

    gzip              on;
    gzip_types        text/css application/javascript application/json image/svg+xml;
    gzip_min_length   1024;
}
