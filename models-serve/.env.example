# Copy to models-serve/.env. Read by the standalone models-serve/docker-compose.yml
# (a GPU host of its own); the main stack sets these in ../docker-compose.yml.

# Shared secret; the API sends it from MODELS_TOKEN in backend/.env. Required as
# soon as the port is reachable from other machines. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MODELS_TOKEN=

DEVICE=cuda:0              # cpu, cuda:0, cuda:1, mps
YOLO_SIZE=n                # n, s, m, l, x (bigger = more accurate, slower)
ALLOW_MODEL_DOWNLOADS=true # false for air-gapped servers (copy weights into WEIGHTS_DIR)
# Loaded at startup so the first run doesn't wait (JSON list of registry keys).
PRELOAD='["yolo26-detect","yolo26-pose","yoloe26"]'
TRACK_SESSION_TTL=300      # seconds an idle video tracking session is kept
MAX_TRACK_SESSIONS=32
LOG_LEVEL=INFO
# WEIGHTS_DIR=./models
